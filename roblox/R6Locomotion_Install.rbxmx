>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">HumanoidRootPart</string><float name="Weight">1</float></Properties><Item class="Pose" referent="RBX00000327"><Properties><CoordinateFrame name="CFrame"><X>-0.0360599</X><Y>-0.5312555</Y><Z>-0.3741922</Z><R00>0.8910381</R00><R01>0.4518297</R01><R02>-0.0436012</R02><R10>-0.3693179</R10><R11>0.6657528</R11><R12>-0.6483653</R12><R20>-0.2639231</R20><R21>0.5938209</R21><R22>0.7600799</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Torso</string><float name="Weight">1</float></Properties><Item class="Pose" referent="RBX00000322"><Properties><CoordinateFrame name="CFrame"><X>1e-07</X><Y>0.0</Y><Z>0.0166615</Z><R00>0.8930209</R00><R01>-0.3640414</R01><R02>-0.2645515</R02><R10>0.4482674</R10><R11>0.6678468</R11><R12>0.5941691</R12><R20>-0.0396222</R20><R21>-0.6491952</R21><R22>0.759589</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Head</string><float name="Weight">1</float></Properties></Item><Item class="Pose" referent="RBX00000323"><Properties><CoordinateFrame name="CFrame"><X>-0.2017282</X><Y>-0.3152864</Y><Z>0.3531442</Z><R00>0.700148</R00><R01>0.6588965</R01><R02>-0.275042</R02><R10>-0.492047</R10><R11>0.7244022</R11><R12>0.4828364</R12><R20>0.5173802</R20><R21>-0.2027234</R21><R22>0.8313969</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Right Arm</string><float name="Weight">1</float></Properties></Item><Item class="Pose" referent="RBX00000324"><Properties><CoordinateFrame name="CFrame"><X>-0.7120636</X><Y>-0.0033157</Y><Z>0.0566398</Z><R00>-0.4860705</R00><R01>0.7651296</R01><R02>0.4222701</R02><R10>-0.6905438</R10><R11>-0.6324084</R11><R12>0.3510108</R12><R20>0.535616</R20><R21>-0.1209801</R21><R22>0.8357508</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Left Arm</string><float name="Weight">1</float></Properties></Item><Item class="Pose" referent="RBX00000325"><Properties><CoordinateFrame name="CFrame"><X>0.8177751</X><Y>0.5309083</Y><Z>-0.2255629</Z><R00>0.4592752</R00><R01>-0.7628047</R01><R02>0.4551871</R02><R10>0.8448045</R10><R11>0.533457</R11><R12>0.041578</R12><R20>-0.2745387</R20><R21>0.3654484</R21><R22>0.8894244</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Right Leg</string><float name="Weight">1</float></Properties></Item><Item class="Pose" referent="RBX00000326"><Properties><CoordinateFrame name="CFrame"><X>0.5677659</X><Y>-0.0482472</Y><Z>-0.1013268</Z><R00>0.614392</R00><R01>-0.5689672</R01><R02>0.5466249</R02><R10>0.6283454</R10><R11>0.7718445</R11><R12>0.0971486</R12><R20>-0.4771838</R20><R21>0.283782</R21><R22>0.8317231</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Left Leg</string><float name="Weight">1</float></Properties></Item></Item></Item></Item><Item class="Keyframe" referent="RBX00000331"><Properties><string name="Name">Keyframe</string><float name="Time">0.666667</float></Properties><Item class="Pose" referent="RBX00000330"><Properties><CoordinateFrame name="CFrame"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">HumanoidRootPart</string><float name="Weight">1</float></Properties><Item class="Pose" referent="RBX0000032F"><Properties><CoordinateFrame name="CFrame"><X>-0.0363745</X><Y>-0.5340602</Y><Z>-0.4074593</Z><R00>0.8881143</R00><R01>0.4574904</R01><R02>-0.0442211</R02><R10>-0.3735903</R10><R11>0.6624831</R11><R12>-0.6492661</R12><R20>-0.2677373</R20><R21>0.5931431</R21><R22>0.7592747</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Torso</string><float name="Weight">1</float></Properties><Item class="Pose" referent="RBX0000032A"><Properties><CoordinateFrame name="CFrame"><X>-0.0</X><Y>0.0</Y><Z>0.016662</Z><R00>0.8901681</R00><R01>-0.3670788</R01><R02>-0.2699144</R02><R10>0.4538957</R10><R11>0.6627595</R11><R12>0.595591</R12><R20>-0.0397404</R20><R21>-0.652689</R21><R22>0.7565828</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Head</string><float name="Weight">1</float></Properties></Item><Item class="Pose" referent="RBX0000032B"><Properties><CoordinateFrame name="CFrame"><X>-0.2044423</X><Y>-0.309062</Y><Z>0.3565733</Z><R00>0.6922945</R00><R01>0.6667541</R01><R02>-0.2759842</R02><R10>-0.4996563</R10><R11>0.7188516</R11><R12>0.4833173</R12><R20>0.5206456</R20><R21>-0.1967008</R21><R22>0.8308051</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Right Arm</string><float name="Weight">1</float></Properties></Item><Item class="Pose" referent="RBX0000032C"><Properties><CoordinateFrame name="CFrame"><X>-0.7205009</X><Y>-0.002838</Y><Z>0.0848711</Z><R00>-0.5023015</R00><R01>0.7535759</R01><R02>0.4240479</R02><R10>-0.6479271</R10><R11>-0.6527669</R11><R12>0.3925373</R12><R20>0.5726112</R20><R21>-0.0775802</R21><R22>0.8161482</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Left Arm</string><float name="Weight">1</float></Properties></Item><Item class="Pose" referent="RBX0000032D"><Properties><CoordinateFrame name="CFrame"><X>0.8387352</X><Y>0.4924666</Y><Z>-0.2319894</Z><R00>0.4559091</R00><R01>-0.7608436</R01><R02>0.4618051</R02><R10>0.8468503</R10><R11>0.5304759</R11><R12>0.0379433</R12><R20>-0.2738454</R20><R21>0.3737811</R21><R22>0.8861695</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Right Leg</string><float name="Weight">1</float></Properties></Item><Item class="Pose" referent="RBX0000032E"><Properties><CoordinateFrame name="CFrame"><X>0.6406152</X><Y>-0.0440958</Y><Z>-0.133107</Z><R00>0.5859345</R00><R01>-0.5891936</R01><R02>0.5563557</R02><R10>0.6492392</R10><R11>0.7521715</R11><R12>0.112811</R12><R20>-0.4849424</R20><R21>0.2951081</R21><R22>0.8232509</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Left Leg</string><float name="Weight">1</float></Properties></Item></Item></Item></Item></Item></Item></Item><Item class="LocalScript" referent="RBXINST000005"><Properties><string name="Name">LocomotionAnimator</string><ProtectedString name="Source"><![CDATA[--!strict
-- LocomotionAnimator (LocalScript, StarterCharacterScripts)
--
-- Plays the reference-matched R6 walk and run cycles on the local player's character.
--
-- * Replication: tracks are loaded on the Humanoid's Animator, which the server creates
--   for every player character. Animations played on it by the owning client replicate
--   to the server and all other clients automatically. No server script is required.
-- * Respawn: this script lives in StarterCharacterScripts, so a fresh copy runs for
--   every new character; all state and connections die with the old character.
-- * Coexistence: the tracks run at Movement priority. The default "Animate" script
--   keeps handling idle/jump/fall/climb/swim/sit (Core/Idle priority), and any Action-
--   priority animation from other systems (e.g. throwing) still overrides these tracks.
-- * Suppression: locomotion fades out whenever the Humanoid leaves the Running state
--   (jumping, freefall, ragdoll, physics, seated, dead...) or while the character has
--   the boolean attribute Config.SuppressAttribute set to true.

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local KeyframeSequenceProvider = game:GetService("KeyframeSequenceProvider")

local LocomotionFolder = ReplicatedStorage:WaitForChild("LocomotionAnimation")
local Config = require(LocomotionFolder:WaitForChild("Config") :: ModuleScript)

local character = script.Parent :: Model
local humanoid = character:WaitForChild("Humanoid") :: Humanoid
local rootPart = character:WaitForChild("HumanoidRootPart") :: BasePart

print(("[LocomotionAnimator] started for %s | rig %s | default Animate script %s"):format(
	character.Name, humanoid.RigType.Name, if character:FindFirstChild("Animate") then "found" else "MISSING"))

if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
	warn("[LocomotionAnimator] Character is not R6 (it is " .. humanoid.RigType.Name
		.. "). Set Game Settings > Avatar > Avatar Type to R6. Disabled.")
	return
end

local animator = humanoid:WaitForChild("Animator") :: Animator

-- Resolve an animation id: published asset id, or (Studio only) a registered
-- KeyframeSequence from ReplicatedStorage.LocomotionAnimation.Sources.
local function resolveAnimationId(assetId: number, sourceName: string): string?
	if assetId and assetId > 0 then
		return "rbxassetid://" .. tostring(assetId)
	end
	if RunService:IsStudio() then
		local sources = LocomotionFolder:FindFirstChild("Sources")
		local sequence = sources and sources:FindFirstChild(sourceName)
		if sequence and sequence:IsA("KeyframeSequence") then
			local ok, tempId = pcall(function()
				return KeyframeSequenceProvider:RegisterKeyframeSequence(sequence)
			end)
			if ok and tempId then
				print(("[LocomotionAnimator] %s: no published id yet, using Studio-only temporary id %s"):format(sourceName, tostring(tempId)))
				return tempId
			end
			warn(("[LocomotionAnimator] %s: could not create a Studio test id (%s). Publish it and set the id in Config."):format(sourceName, tostring(tempId)))
			return nil
		end
	end
	warn(("[LocomotionAnimator] No animation id for %s (set it in LocomotionAnimation.Config, and check that"
		.. " ReplicatedStorage.LocomotionAnimation.Sources.%s exists)."):format(sourceName, sourceName))
	return nil
end

local function loadTrack(assetId: number, sourceName: string): AnimationTrack?
	local id = resolveAnimationId(assetId, sourceName)
	if not id then
		return nil
	end
	local animation = Instance.new("Animation")
	animation.Name = sourceName
	animation.AnimationId = id
	local track = animator:LoadAnimation(animation)
	track.Priority = Enum.AnimationPriority.Movement
	track.Looped = true
	task.delay(3, function()
		if track.Length > 0 then
			print(("[LocomotionAnimator] %s loaded OK (%.3f s, id %s)"):format(sourceName, track.Length, id))
		else
			warn(("[LocomotionAnimator] %s did NOT load (id %s). If this is a published id, it must be owned by the"
				.. " game's owner (your group)."):format(sourceName, id))
		end
	end)
	return track
end

local walkTrack = loadTrack(Config.WalkAnimationId, "R6_Walk")
local runTrack = loadTrack(Config.RunAnimationId, "R6_Run")
if not walkTrack or not runTrack then
	-- Leave the default Animate script fully in charge rather than half-working.
	return
end

type Mode = "none" | "walk" | "run"
local tracks: { [Mode]: AnimationTrack } = { walk = walkTrack :: AnimationTrack, run = runTrack :: AnimationTrack }
local referenceSpeed: { [Mode]: number } = { walk = Config.WalkReferenceSpeed, run = Config.RunReferenceSpeed }

local LOCOMOTION_STATES: { [Enum.HumanoidStateType]: boolean } = {
	[Enum.HumanoidStateType.Running] = true,
	[Enum.HumanoidStateType.RunningNoPhysics] = true,
	[Enum.HumanoidStateType.Landed] = true,
}

local currentMode: Mode = "none"
local smoothedSpeed = 0

local function phaseOf(track: AnimationTrack): number?
	if track.IsPlaying and track.Length > 0 then
		return (track.TimePosition % track.Length) / track.Length
	end
	return nil
end

local function setMode(newMode: Mode, fade: number)
	if newMode == currentMode then
		return
	end
	local oldTrack = if currentMode ~= "none" then tracks[currentMode] else nil
	if newMode == "none" then
		if oldTrack then
			oldTrack:Stop(fade)
		end
	else
		local newTrack = tracks[newMode]
		-- Both cycles start on the same foot contact, so carrying the normalized phase
		-- across a walk<->run switch keeps the legs continuous during the crossfade.
		local phase = if oldTrack then phaseOf(oldTrack) else nil
		newTrack:Play(fade, 1, 1)
		if phase and newTrack.Length > 0 then
			newTrack.TimePosition = phase * newTrack.Length
		end
		if oldTrack then
			oldTrack:Stop(fade)
		end
	end
	currentMode = newMode
	print("[LocomotionAnimator] now playing: " .. newMode)
end

local function horizontalSpeed(): number
	local v = rootPart.AssemblyLinearVelocity
	return Vector3.new(v.X, 0, v.Z).Magnitude
end

local function update(dt: number)
	-- Exponential smoothing (~0.08 s) removes single-frame physics spikes.
	local alpha = 1 - math.exp(-dt / 0.08)
	smoothedSpeed += (horizontalSpeed() - smoothedSpeed) * alpha

	local suppressed = character:GetAttribute(Config.SuppressAttribute) == true
	local grounded = LOCOMOTION_STATES[humanoid:GetState()] == true
		and humanoid.FloorMaterial ~= Enum.Material.Air

	if suppressed or not grounded or humanoid.Health <= 0 then
		setMode("none", Config.SuspendFade)
		return
	end

	local target: Mode
	if smoothedSpeed < Config.MinMoveSpeed then
		target = "none"
	elseif currentMode == "run" then
		target = if smoothedSpeed >= Config.RunExitSpeed then "run" else "walk"
	else
		target = if smoothedSpeed >= Config.RunEnterSpeed then "run" else "walk"
	end

	if target == "none" then
		setMode("none", Config.StopFade)
	elseif currentMode == "none" then
		setMode(target, Config.StartFade)
	else
		setMode(target, Config.SwitchFade)
	end

	if currentMode ~= "none" then
		local rate = smoothedSpeed / referenceSpeed[currentMode]
		tracks[currentMode]:AdjustSpeed(math.clamp(rate, Config.MinPlaybackRate, Config.MaxPlaybackRate))
	end
end

local heartbeat = RunService.Heartbeat:Connect(update)

-- Optional built-in sprint (Config.EnableSprintKey). Restores the previous WalkSpeed on release,
-- so other systems that set WalkSpeed while not sprinting keep working.
local sprintConnections: { RBXScriptConnection } = {}
if Config.EnableSprintKey then
	local SPRINT_KEYS = {
		[Enum.KeyCode.LeftShift] = true,
		[Enum.KeyCode.RightShift] = true,
		[Enum.KeyCode.ButtonL3] = true,
	}
	local sprinting = false
	local speedBeforeSprint = humanoid.WalkSpeed
	local function setSprint(on: boolean)
		if on == sprinting then
			return
		end
		sprinting = on
		if on then
			speedBeforeSprint = humanoid.WalkSpeed
			humanoid.WalkSpeed = Config.SprintSpeed
		elseif humanoid.WalkSpeed == Config.SprintSpeed then
			humanoid.WalkSpeed = speedBeforeSprint
		end
	end
	table.insert(sprintConnections, UserInputService.InputBegan:Connect(function(input)
		-- Don't rely on gameProcessedEvent: Shift Lock binds Shift too. Only skip while typing.
		if SPRINT_KEYS[input.KeyCode] and not UserInputService:GetFocusedTextBox() then
			setSprint(true)
		end
	end))
	table.insert(sprintConnections, UserInputService.InputEnded:Connect(function(input)
		if SPRINT_KEYS[input.KeyCode] then
			setSprint(false)
		end
	end))
end

local function shutdown()
	heartbeat:Disconnect()
	for _, connection in sprintConnections do
		connection:Disconnect()
	end
	for _, track in tracks do
		track:Stop(0)
		track:Destroy()
	end
end

humanoid.Died:Once(function()
	setMode("none", Config.SuspendFade)
end)
character.Destroying:Once(shutdown)
]]></ProtectedString></Properties></Item></Item></roblox>