<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBXINST000006"><Properties><string name="Name">R6Locomotion_Install</string></Properties><Item class="ModuleScript" referent="RBXINST000001"><Properties><string name="Name">README</string><ProtectedString name="Source"><![CDATA[-- HOW TO INSTALL (Roblox Studio)
-- 1. Drag the folder 'LocomotionAnimation' into ReplicatedStorage.
-- 2. Drag the LocalScript 'LocomotionAnimator' into StarterPlayer > StarterCharacterScripts.
-- 3. Delete this 'R6Locomotion_Install' folder.
-- Press Play: walking/running works in Studio right away (temporary Studio-only animations).
-- For the live game: right-click LocomotionAnimation > Sources > R6_Walk > 'Save to Roblox',
--    choose your group as the creator, copy the ID, paste it into Config (WalkAnimationId).
--    Do the same for R6_Run (RunAnimationId). Then publish the game.
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBXINST000004"><Properties><string name="Name">LocomotionAnimation</string></Properties><Item class="ModuleScript" referent="RBXINST000002"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Locomotion animation configuration (R6).
--
-- After publishing the two KeyframeSequences (see README "Roblox Studio import"),
-- paste the resulting asset IDs below. While an ID is left at 0, the controller
-- falls back to the KeyframeSequence in ReplicatedStorage.LocomotionAnimation.Sources
-- *in Studio only* (KeyframeSequenceProvider:RegisterKeyframeSequence), so you can
-- test before publishing. Live servers require real published IDs.

local Config = {}

Config.WalkAnimationId = 0 -- rbxassetid of R6_Walk
Config.RunAnimationId = 0 -- rbxassetid of R6_Run

-- Ground speed (studs/s) at which each animation plays at exactly the timing of the
-- reference video (walk cycle 1.000 s, run cycle 0.667 s). Playback speed is scaled
-- by currentSpeed / referenceSpeed so feet keep pace with the character.
Config.WalkReferenceSpeed = 16 -- Roblox default Humanoid.WalkSpeed
Config.RunReferenceSpeed = 26

-- Speed band selection. Above RunEnterSpeed the run plays; it keeps playing until the
-- speed drops below RunExitSpeed (hysteresis prevents flicker at the boundary).
Config.MinMoveSpeed = 0.75
Config.RunEnterSpeed = 20
Config.RunExitSpeed = 18.5

-- Clamp for the speed-scaled playback rate.
Config.MinPlaybackRate = 0.55
Config.MaxPlaybackRate = 1.6

-- Crossfade durations (seconds).
Config.StartFade = 0.15 -- idle -> moving
Config.StopFade = 0.2 -- moving -> idle
Config.SwitchFade = 0.25 -- walk <-> run (phase-synced)
Config.SuspendFade = 0.1 -- jump/fall/ragdoll/suppression

-- Set this attribute (boolean) to true on the character model from any existing
-- system (e.g. while a crash/ragdoll or a full-body throw is active) to fade the
-- locomotion animations out without touching that system's own animations.
Config.SuppressAttribute = "LocomotionSuppressed"

return Config
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBXINST000003"><Properties><string name="Name">Sources</string></Properties><Item class="KeyframeSequence" referent="RBX000001E9"><Properties><bool name="Loop">true</bool><string name="Name">R6_Walk</string><token name="Priority">1</token></Properties><Item class="Keyframe" referent="RBX00000008"><Properties><string name="Name">Keyframe</string><float name="Time">0.0</float></Properties><Item class="Pose" referent="RBX00000007"><Properties><CoordinateFrame name="CFrame"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">HumanoidRootPart</string><float name="Weight">1</float></Properties><Item class="Pose" referent="RBX00000006"><Properties><CoordinateFrame name="CFrame"><X>-0.0320903</X><Y>-0.1037006</Y><Z>-0.0572972</Z><R00>0.9816662</R00><R01>0.1865731</R01><R02>-0.0390128</R02><R10>-0.1900588</R10><R11>0.9736447</R11><R12>-0.1260705</R12><R20>0.0144633</R20><R21>0.1311739</R21><R22>0.9912539</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Torso</string><float name="Weight">1</float></Properties><Item class="Pose" referent="RBX00000001"><Properties><CoordinateFrame name="CFrame"><X>1e-07</X><Y>0.0</Y><Z>0.0166626</Z><R00>0.9828097</R00><R01>-0.1841642</R01><R02>0.0129862</R02><R10>0.1807657</R10><R11>0.974201</R11><R12>0.1351156</R12><R20>-0.0375347</R20><R21>-0.1304454</R21><R22>0.9907447</R22></CoordinateFrame><token name="EasingDirection">0</token><token name="EasingStyle">0</token><string name="Name">Head</string><float name="Weight">1</float></Properties></Item><Item class="Pose" referent="RBX00000002"><Properties><CoordinateFrame name="CFrame"><X>-0.1140731</X><Y>-0.1613229</Y><Z>0.2240103</Z><R00>0.6447603